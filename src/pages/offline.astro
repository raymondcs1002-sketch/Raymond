---
// Self-contained on purpose: this is the service worker's offline fallback,
// so it can't depend on hashed CSS/JS assets that may not be cached.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>You're offline</title>
    <style>
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #ffffff;
        color: #12201e;
        text-align: center;
        padding: 24px;
      }
      .btn {
        display: inline-block;
        margin-top: 16px;
        background: #0f766e;
        color: #fff;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div>
      <h1>You're offline</h1>
      <p>Check your internet connection and try again.</p>
      <a class="btn" href="/">Retry</a>
    </div>
  </body>
</html>
