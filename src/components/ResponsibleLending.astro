---
import { en } from "../i18n/en";
import Icon from "./Icon.astro";

const icons = ["shield", "message", "check"];
---

<section class="section section--alt">
  <div class="container">
    <div class="section-header section-header--center">
      <h2>{en.responsibleLending.title}</h2>
    </div>
    <div class="grid grid--3">
      {
        en.responsibleLending.pillars.map((pillar, i) => (
          <div class="icon-card">
            <div class="icon-card__icon">
              <Icon name={icons[i]} size={22} />
            </div>
            <h3>{pillar.title}</h3>
            <p style="color: var(--color-text-muted); margin: 0;">{pillar.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
