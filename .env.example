# --- Vercel Global Config (formerly "Edge Config") ----------------------
# Set automatically by Vercel when you connect a Global Config store to
# this project (Storage tab → Create → Global Config → connect).
# For local dev, run `vercel env pull` after linking the project, or
# leave unset — the site falls back to placeholder content.
# (A store connected before 2026-07-29 sets EDGE_CONFIG instead — either
# name works, the app checks both.)
GLOBAL_CONFIG=

# --- Supabase (leads + KYC documents) ----------------------------------
# Service role key — SERVER ONLY. Never expose this to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anon/public key — safe to expose. Sent to the browser so it can upload
# KYC files directly to Storage using the signed upload URLs the server
# creates. Find it in Supabase → Project Settings → API → anon public key.
PUBLIC_SUPABASE_ANON_KEY=

# --- Email notifications (Resend) --------------------------------------
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# --- Misc ----------------------------------------------------------------
# Salt used to hash applicant IPs for rate limiting. Set a long random
# value in production; raw IPs are never stored.
IP_HASH_SALT=
